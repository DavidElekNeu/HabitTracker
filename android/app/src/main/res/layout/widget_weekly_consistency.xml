<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_weekly_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/striveup_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_weekly_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Weekly consistency"
        android:textColor="#E6FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_weekly_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0/7 active days"
        android:textColor="#E6FFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_weekly_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="0%"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_weekly_day1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="M\n."
            android:textColor="#F0F4F8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_weekly_day2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="T\n."
            android:textColor="#F0F4F8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_weekly_day3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="W\n."
            android:textColor="#F0F4F8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_weekly_day4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="T\n."
            android:textColor="#F0F4F8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_weekly_day5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="F\n."
            android:textColor="#F0F4F8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_weekly_day6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="S\n."
            android:textColor="#F0F4F8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_weekly_day7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="S\n."
            android:textColor="#F0F4F8"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
